<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · InventoryHub</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">InventoryHub</a>
        <nav>
            <a href="/Products">Productos</a>
            <a href="/api/products">API</a>
        </nav>
        <span id="live-indicator" class="live">● live</span>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">© @DateTime.UtcNow.Year InventoryHub</footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/inventory.js"></script>
</body>
</html>